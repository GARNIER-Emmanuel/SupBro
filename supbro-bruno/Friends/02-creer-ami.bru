  meta {
  name: 02-creer-ami
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/friends
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstname": "Bruno-Lucas",
    "lastname": "Test",
    "notes": "Contact fictif pour apprendre Bruno"
  }
}

script:pre-request {
  bru.setVar("friendId", "");
  
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("friendId", String(res.getBody().id));
  }
}

tests {
  test("Création acceptée", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Réponse du contact créé", function () {
    const body = res.getBody();
    expect(body.id).to.be.a("number");
    expect(body.firstname).to.equal("Bruno-Lucas");
    expect(body.createdAt).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
