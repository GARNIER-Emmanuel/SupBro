meta {
  name: 06-date-invalide
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/friends
  body: json
  auth: inherit
}

body:json {
  {
    "firstname":"Bruno-Erreur",
    "birthday":"pas-une-date"
  }
}

tests {
  test("La date invalide est refusée", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("INVALID_JSON");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
